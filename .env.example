# Modèle basé sur les variables et leur ordre dans le .env local.
# Copier vers .env puis renseigner les secrets ; ne jamais versionner le vrai .env.
# Les identifiants ci-dessous sont des exemples publics, sans valeur de production.

# Authentification : comptes de démonstration uniquement.
USERS={"alice":"wonderland"}
ADMIN_USERS=["alice"]
PULL_USERS=["alice"]
TRAIN_USERS=["alice"]

# Jobs initial/hebdomadaire : Make permet aussi TRAIN_USERNAME=... TRAIN_PASSWORD=....
TRAIN_USERNAME=alice
TRAIN_PASSWORD=wonderland
PULL_USERNAME=alice
PULL_PASSWORD=wonderland
INITIAL_IDEMPOTENCY_KEY=initial-bootstrap

# JWT : remplacer chaque secret distinct par une valeur aléatoire avant déploiement.
JWT_SECRET_LOGIN=change-me-login-secret-at-least-32-bytes
JWT_SECRET_PULL=change-me-pull-secret-at-least-32-bytes
JWT_SECRET_TRAIN=change-me-train-secret-at-least-32-bytes
JWT_ALGORITHM=HS256

# Accès distant DagsHub : fournir ses propres identifiants.
DAGSHUB_USERNAME=your-dagshub-username
DAGSHUB_TOKEN=your-dagshub-token

# DAGs Airflow : comptes de service et URLs internes Compose.
AIRFLOW_SERVICE_USERNAME=alice
AIRFLOW_SERVICE_PASSWORD=wonderland
AUTH_API_URL=http://auth-api:8000/login
PULL_API_URL=http://pull-data-api:8000/pull_data
TRAIN_API_URL=http://train-api:8000/train
PREDICT_API_URL=http://predict-api:8000/reload
API_RETRIES=3
API_CONNECT_TIMEOUT_SECONDS=10
AUTH_API_TIMEOUT_SECONDS=30
PULL_API_TIMEOUT_SECONDS=7200
TRAIN_API_TIMEOUT_SECONDS=7200
BENTO_MODEL_NAME=accidents
CURRENT_MODEL_FILE=/bentoml/current_model.txt

# Variable historique conservée pour refléter .env ; non lue par le code actuel.
DVC_PUSH_ENABLED=true

# Identité du bot qui publie les pointeurs DVC ; aucun secret dans cette identité.
GIT_AUTHOR_NAME=airflow-dvc-bot
GIT_AUTHOR_EMAIL=airflow-dvc-bot@localhost
GIT_COMMITTER_NAME=airflow-dvc-bot
GIT_COMMITTER_EMAIL=airflow-dvc-bot@localhost

# Token Git à portée minimale ; ne jamais versionner la vraie valeur.
GIT_PUSH_TOKEN=your-github-fine-grained-token
DVC_GIT_REMOTE=origin

# Compose direct : adapter avec id -u / id -g. Make utilise 1000:1000 sauf surcharge explicite.
LOCAL_UID=1000
LOCAL_GID=1000

# Airflow local : générer une vraie clé Fernet avant déploiement VPS.
AIRFLOW_UID=1000
FERNET_KEY=

# Webhook Slack : remplacer par son URL privée avant activation des alertes.
GF_SLACK_WEBHOOK=https://hooks.slack.com/services/REPLACE/ME

# MLflow/PostgreSQL : mot de passe de démonstration à remplacer.
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me-local-only
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT_NAME=accidents-gravity
MLFLOW_ALLOWED_HOSTS=localhost:5000,127.0.0.1:5000,localhost:5001,127.0.0.1:5001,mlflow-server:5001

# Variable historique conservée pour refléter .env ; non lue par le code actuel.
ACCIDENT_MODEL_SOURCE=mlflow
MLFLOW_REGISTERED_MODEL_NAME=accidents-gravity-classifier
MLFLOW_CHAMPION_ALIAS=champion
